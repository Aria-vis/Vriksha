# Vriksha Client Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Map Tile Configuration (Optional override; defaults to free Carto Voyager & OpenStreetMap)
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# Feature Flags
VITE_ENABLE_INAT_VISION=true
VITE_ENABLE_VOICE_SEARCH=true

# Seeding & CLI Scripts (Used only for local scripts/seed, never bundled in frontend)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SEED_DEMO=true
